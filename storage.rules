rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function validImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }
    function validPdf() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
    function validAttachmentUpload() {
      return request.resource != null && (validImage() || validPdf());
    }

    // Server-side uploads (Cloud Functions Admin SDK) bypass these rules.
    // Authenticated teacher/admin may upload directly as fallback.
    match /attachments/{channel}/{ownerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && validAttachmentUpload();
    }
  }
}
