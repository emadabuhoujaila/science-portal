{
  "name": "science-portal-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "migrate:teachers": "node scripts/migrate-teachers.mjs",
    "migrate:teachers:dry": "node scripts/migrate-teachers.mjs --dry-run",
    "create:admin": "node scripts/create-admin.mjs",
    "sync:public-teachers": "node scripts/sync-public-teachers.mjs",
    "reset:teachers-admins": "node scripts/reset-teachers-admins.mjs",
    "seed:teacher-allowlist": "node scripts/seed-teacher-allowlist.mjs",
    "deploy:rules": "firebase deploy --only database",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:push": "firebase deploy --only functions,database",
    "deploy:attachments": "firebase deploy --only storage,database,functions",
    "seed:fcm": "node scripts/seed-fcm-config.mjs",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "publish:github": "powershell -ExecutionPolicy Bypass -File scripts/publish-github.ps1",
    "icons:android": "npx capacitor-assets generate --iconBackgroundColor \"#0d6e6e\" --iconBackgroundColorDark \"#0d6e6e\" --android",
    "icons:ios": "npx capacitor-assets generate --iconBackgroundColor \"#0d6e6e\" --iconBackgroundColorDark \"#0d6e6e\" --ios"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.2.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
