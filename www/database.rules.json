{
  "rules": {
    ".read": false,
    ".write": false,
    "students": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "teachers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$key": {
        ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "teacherLookup": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "teacherData": {
      "$key": {
        ".read": true,
        ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "publicTeachers": {
      ".read": true,
      "$key": {
        ".write": "auth != null && ((!data.exists() && root.child('teachers').child($key).child('uid').val() === auth.uid) || root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "registeredParents": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$mid": {
        ".write": "newData.child('mid').val() == $mid || (auth != null && root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "complaints": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(!data.exists() && newData.child('status').val() === 'pending' && newData.hasChildren(['body','teacherKey','studentName','cls','mid','ts'])) || (auth != null && root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "parentAdminInbox": {
      "$mid": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.child('mid').val() == $mid"
        }
      }
    }
  }
}
