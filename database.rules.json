      "$key": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin' || (auth.token.email != null && $key === auth.token.email.toLowerCase().replace('@', '_').replace('.', '_')))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "teachers": {
