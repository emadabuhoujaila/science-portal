      "$key": {
        ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('teacherAllowlist').child($key).exists() && auth.token.email != null && newData.child('email').val().toLowerCase() === auth.token.email.toLowerCase()) || root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "teacherLookup": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists() && root.child('teacherAllowlist').child(newData.child('key').val()).exists()) || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      },
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
      ".write": false
    },

    "teacherData": {
      "$key": {
        ".read": false,
        ".write": false,

        "grades": {
          ".read": true,
          ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          "$bucket": {
            ".read": true,
            "$mid": {
              ".read": true,
              ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
            }
          }
        },

        "messages": {
          ".read": true,
          ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          "$msgId": {
            ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
          }
        },

        "behaviorLog": {
          ".read": true,
          ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          "$entryId": {
            ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
          }
        },

        "parentMessages": {
          ".read": true,
          "$msgId": {
            ".write": "(!data.exists() && newData.hasChildren(['cls','name','body','ts']) && newData.child('cls').isString() && newData.child('name').isString() && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000 && newData.child('ts').isString()) || (auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))"
          }
        },

        "complaintInbox": {
          ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          "$inboxId": {
            ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
            ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
          }
        },

        "adminMessages": {
          ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          "$msgId": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
          }
        },

        "settings": {
          ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
        },

        "students": {
          ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
          "$bucket": {
            ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
            "$mid": {
              ".read": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
              ".write": "auth != null && (root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
            }
          }
        }
      }
    },

    "publicTeachers": {
      ".read": true,
      "$key": {
        ".write": "auth != null && ((!data.exists() && root.child('teachers').child($key).child('uid').val() === auth.uid && root.child('teacherAllowlist').child($key).exists()) || root.child('teacherLookup').child(auth.uid).child('key').val() === $key || root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "registeredParents": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
      "$mid": {
        ".read": true,
        ".write": "(newData.child('mid').val() == $mid && newData.hasChildren(['cls','name','mid']) && root.child('students').child(newData.child('cls').val()).child(newData.child('section').val()).child($mid).exists()) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))"
      }
    },

    "parentQuickLogin": {
      "$key": {
        ".read": true,
        ".write": "(auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')) || (!data.exists() && newData.child('mid').val() != null && newData.child('cls').val() != null && newData.child('name').val() != null && root.child('students').child(newData.child('cls').val()).child(newData.child('section').val()).child(newData.child('mid').val()).exists()) || (data.exists() && newData.child('mid').val() === data.child('mid').val() && newData.child('cls').val() === data.child('cls').val() && newData.child('name').val() === data.child('name').val())"
      }
    },

    "complaints": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
      "$id": {
        ".write": "(!data.exists() && newData.child('status').val() === 'pending' && newData.hasChildren(['body','teacherKey','studentName','cls','mid','ts']) && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))"
      }
    },

    "adminInbox": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
      "$id": {
        ".write": "(!data.exists() && newData.hasChildren(['body','ts']) && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000 && newData.child('ts').isString() && (!newData.child('fromRole').exists() || newData.child('fromRole').val() === 'parent' || (newData.child('fromRole').val() === 'teacher' && auth != null && root.child('teacherLookup').child(auth.uid).child('key').val() === newData.child('teacherKey').val()))) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))"
      }
    },

    "adminOutbox": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')",
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "parentAdminInbox": {
      "$mid": {
        ".read": true,
        "$id": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin') && newData.child('mid').val() == $mid"
        }
      }
    },

    "parentComplaintLog": {
      "$mid": {
        ".read": true,
        "$id": {
          ".write": "(!data.exists() && newData.child('mid').val() == $mid && newData.hasChildren(['body','ts','teacherKey','studentName','cls']) && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000 && newData.child('status').val() === 'pending') || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))",
          "thread": {
            "$msgId": {
              ".write": "(!data.exists() && newData.hasChildren(['body','ts','role']) && newData.child('role').val() === 'parent' && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000 && newData.child('ts').isString()) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))"
            }
          }
        }
      }
    },

    "parentMessagesToAdmin": {
      "$mid": {
        ".read": true,
        "$id": {
          ".write": "(!data.exists() && newData.child('mid').val() == $mid && newData.hasChildren(['body','ts']) && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000 && newData.child('ts').isString()) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))"
        }
      }
    },

    "teacherMessagesToAdmin": {
      "$key": {
        ".read": "auth != null && root.child('teacherLookup').child(auth.uid).child('key').val() === $key",
        "$id": {
          ".write": "(!data.exists() && auth != null && root.child('teacherLookup').child(auth.uid).child('key').val() === $key && newData.hasChildren(['body','ts']) && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000 && newData.child('ts').isString()) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin'))"
        }
      }
    },

    "fcmTokens": {
      "parents": {
        "$mid": {
          ".read": false,
          "$tokenId": {
            ".write": "newData.child('token').isString() && newData.child('mid').val() == $mid && root.child('registeredParents').child($mid).exists()",
            ".read": false
          }
        }
      },
      "teachers": {
        "$key": {
          ".read": "auth != null && root.child('teacherLookup').child(auth.uid).child('key').val() === $key",
          "$tokenId": {
            ".write": "auth != null && root.child('teacherLookup').child(auth.uid).child('key').val() === $key && newData.child('token').isString()",
            ".read": "auth != null && root.child('teacherLookup').child(auth.uid).child('key').val() === $key"
          }
        }
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$tokenId": {
            ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || root.child('teacherLookup').child(auth.uid).child('role').val() === 'admin') && newData.child('token').isString()",
            ".read": "auth != null && auth.uid === $uid"
          }
        }
